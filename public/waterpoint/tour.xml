  <view hlookat="-115" vlookat="12" fov="100" fovmin="45" fovmax="115" limitview="auto" maxpixelzoom="1.0" />
  <preview url="pano/01-truc-duong-vao/01-truc-duong-vao.tiles/preview.jpg" />
  <image type="CUBE" multires="true" tilesize="512">
    <level tiledimagewidth="2624" tiledimageheight="2624"><cube url="pano/01-truc-duong-vao/01-truc-duong-vao.tiles/%s/l3/%v/l3_%s_%v_%h.jpg" /></level>
