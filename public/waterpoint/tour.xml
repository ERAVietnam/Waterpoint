<!-- ============================================================
     TAB 2 - "THUC TE"
     7 canh flycam THAT do ERA tu bay, DJI FC3170.
     Anh goc 8192x4096 -> MULTIRES 3 level (2624 / 1280 / 640).

       canh1  bay  94 m  truc duong vao       08/09 15:57   co GPS
       canh2  bay 259 m  vong xoay loi vao    08/09 15:49   co GPS
       canh3  bay 391 m  ho canh quan         08/09 14:34   co GPS
       canh4  bay 390 m  toan canh Aquaria    08/09 14:40   co GPS
       canh5  bay 410 m  Aquaria & song       08/09 14:45   co GPS
       canh6  bay 400 m  Rivera               05/09         KHONG GPS -> cham tay
       canh7  bay 499 m  The Pearl            05/09         KHONG GPS -> cham tay

     🔴🔴🔴 BAY MOI (10/09/2026) - TEN SCENE KHONG DUOC BAT DAU BANG CHU SO.
     Ban truoc dat ten "01-truc-duong-vao" -> krpano hieu la BIEU THUC SO HOC,
     vut ten di, tu dat lai thanh n1..n5, va scene[0].name tra ve NULL
     => loadscene(null) => MAN DEN, KHONG MOT DONG LOI NAO.
     Bang chung: scene.count=6 (thua 1), ten = [null,n1,n2,n3,n4,n5].
     LUAT: ten scene bat dau bang CHU CAI. Ten THU MUC/FILE thi so van OK.

     Bieu tuong flycam giua cac canh do index.html ve bang HTML,
     toa do nap tu canh.json.
     Engine krpano 1.19-pr16 - BAN DA MUA cua ERA.
     ============================================================ -->

<autorotate enabled="false" waittime="5.0" speed="2.0" horizon="0.0" />

<!-- 12/09: BO tween zoom moi lan vao canh. Anh Tony bi say (dau ong ong,
     buon non). Zoom cuong buc 120->90 trong 1.2s = chuyen dong nguoi xem
     KHONG dieu khien duoc -> vection conflict. Vao canh la dung yen. -->
<action name="vao_canh">
  <!-- 12/09: bo `set(view.fov,100)`. No GHI DE fov rieng cua tung canh,
       nen canh nao dat fov khac trong <view> cung bi keo ve 100. -->
</action>

<!-- 12/09: giam quan tinh keo chuot. mousefriction mac dinh 0.9 = anh con
     TROI tiep sau khi tha tay -> cam giac lenh denh. 0.5 = dung gan nhu ngay. -->
<control mousespeed="8.0" mousefriction="0.5" mouseaccelerate="1.0" />

<action name="startup" autorun="onstart">
  loadscene(canh1_truc_duong_vao, null, MERGE);
</action>

<scene name="canh1_truc_duong_vao" title="Trục đường vào" cao="94" onstart="vao_canh();">
